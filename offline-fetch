import os
import re
import sys
import shutil
import argparse
import subprocess
from datetime import datetime

PROJECT_ROOT = os.path.dirname(os.path.abspath(__file__))
DEPS_CMAKE = os.path.join(PROJECT_ROOT, "scripts", "dependencies.cmake")
WEBUI_DIR = os.path.join(PROJECT_ROOT, "src", "DaliMQTT", "webui")

def parse_dependencies(cmake_file):
    """Parses dependencies.cmake and returns list (name, url, tag)"""
    if not os.path.exists(cmake_file):
        print(f"Error: Cannot find {cmake_file}")
        sys.exit(1)

    with open(cmake_file, 'r', encoding='utf-8') as f:
        content = f.read()

    blocks = re.findall(r'FetchContent_Declare\s*\((.*?)\)', content, re.DOTALL | re.IGNORECASE)

    deps = []
    for block in blocks:
        clean_block = re.sub(r'#.*?\n', '\n', block)
        tokens = clean_block.split()
        if not tokens:
            continue

        name = tokens[0]
        url = None
        tag = None

        if "GIT_REPOSITORY" in tokens:
            url = tokens[tokens.index("GIT_REPOSITORY") + 1].strip('"')
        if "GIT_TAG" in tokens:
            tag = tokens[tokens.index("GIT_TAG") + 1].strip('"')

        if url:
            deps.append((name, url, tag))

    return deps

def run_command(cmd, cwd=None):
    is_windows = os.name == 'nt'
    try:
        subprocess.run(cmd, cwd=cwd, check=True, shell=is_windows)
    except subprocess.CalledProcessError as e:
        print(f"\n[!] Command failed: {' '.join(cmd)}")
        sys.exit(e.returncode)

def prepare_offline_assets(archive_name):
    """Downloads repos, builds WebUI, and packages into a ZIP file."""
    if archive_name.endswith('.zip'):
        archive_name = archive_name[:-4]

    temp_dir = os.path.abspath(f"{archive_name}_tmp")
    os.makedirs(temp_dir, exist_ok=True)

    deps = parse_dependencies(DEPS_CMAKE)
    print(f"Found {len(deps)} dependencies in CMake.")

    for name, url, tag in deps:
        target_dir = os.path.join(temp_dir, name)
        print(f"[*] Downloading {name}...")
        cmd = ["git", "clone", "--depth", "1"]
        if tag:
            cmd.extend(["--branch", tag])
        cmd.extend([url, target_dir])
        run_command(cmd)

    print("\n[*] Building WebUI...")
    dist_dir = os.path.join(WEBUI_DIR, "dist")
    if os.path.exists(dist_dir):
        shutil.rmtree(dist_dir)

    run_command(["npm", "ci"], cwd=WEBUI_DIR)
    run_command(["npm", "run", "build"], cwd=WEBUI_DIR)

    webui_out = os.path.join(temp_dir, "webui_dist")
    shutil.copytree(dist_dir, webui_out)
    print(f"[+] WebUI built and copied to archive payload")

    print("\n[*] Packing to ZIP archive...")
    zip_path = shutil.make_archive(archive_name, 'zip', temp_dir)

    print("[*] Cleaning up temporary directory...")
    shutil.rmtree(temp_dir)

    print(f"\n[SUCCESS] All offline assets packaged to: {zip_path}")
    print("Transfer this ZIP file to the offline machine.")

def apply_offline_assets(archive_path, extract_dir):
    """Extracts ZIP, copies WebUI to destination, and prints CMake flags"""
    archive_path = os.path.abspath(archive_path)
    extract_dir = os.path.abspath(extract_dir)

    if not os.path.exists(archive_path):
        print(f"Error: Archive {archive_path} not found.")
        sys.exit(1)

    print(f"[*] Extracting {archive_path} to {extract_dir}...")
    if os.path.exists(extract_dir):
        shutil.rmtree(extract_dir)
    shutil.unpack_archive(archive_path, extract_dir)

    webui_src = os.path.join(extract_dir, "webui_dist")
    webui_dst = os.path.join(WEBUI_DIR, "dist")

    if os.path.exists(webui_src):
        print(f"[*] Copying WebUI assets to {webui_dst}...")
        if os.path.exists(webui_dst):
            shutil.rmtree(webui_dst)
        shutil.copytree(webui_src, webui_dst)
    else:
        print("[!] Warning: 'webui_dist' not found in the archive.")

    generate_cmake_args(extract_dir, auto_applied=True)

def generate_cmake_args(assets_dir, auto_applied=False):
    """Generates CMake flags"""
    assets_dir = os.path.abspath(assets_dir)
    if not os.path.exists(assets_dir):
        print(f"Error: Assets directory {assets_dir} does not exist.")
        sys.exit(1)

    deps = parse_dependencies(DEPS_CMAKE)

    flags = []
    for name, _, _ in deps:
        var_name = f"FETCHCONTENT_SOURCE_DIR_{name.upper()}"
        dep_path = os.path.join(assets_dir, name)
        dep_path = dep_path.replace('\\', '/')
        flags.append(f"-D{var_name}={dep_path}")

    print("\nCMake Arguments for Offline Build\n")
    print(" ".join(flags))

    print("\nInstructions for Offline Build")
    if auto_applied:
        print("[OK] WebUI 'dist' folder is already copied to the correct location.")
        print("Run CMake with the generated flags above. Example:")
        print("  cmake -B build -G Ninja <INSERT_FLAGS_HERE>\n")
    else:
        print(f"1. Copy the 'webui_dist' folder content from '{assets_dir}' into '{os.path.relpath(os.path.join(WEBUI_DIR, 'dist'), PROJECT_ROOT)}'")
        print("   (Because npm is not available, CMake will use this pre-built dist folder)")
        print("2. Run CMake with the generated flags above. Example:")
        print("   cmake -B build -G Ninja <INSERT_FLAGS_HERE>\n")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="DaliMQTT Offline Helper Tool\n"
                    "Automates fetching dependencies and building WebUI for offline compilation.",
        epilog="Quick Extract Mode (Offline Machine):\n"
               "  Simply pass the ZIP file to extract and apply it automatically:\n"
               "  %(prog)s dali_assets.zip\n\n"
               "For full details, run: %(prog)s <command> --help",
        formatter_class=argparse.RawTextHelpFormatter
    )

    subparsers = parser.add_subparsers(dest="command", title="Available commands")

    default_archive = f"dali_assets_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
    parser_prep = subparsers.add_parser("prepare", help="Download repos, build WebUI, and pack to ZIP (Requires Internet)")
    parser_prep.add_argument("archive_name", nargs="?", default=default_archive, help=f"Name of the output zip file (default: {default_archive}.zip)")

    parser_apply = subparsers.add_parser("apply", help="Extract ZIP, copy WebUI and show CMake flags")
    parser_apply.add_argument("archive", help="Path to the offline assets ZIP file")
    parser_apply.add_argument("out_dir", nargs="?", default="./offline_assets", help="Directory to extract git repos to (default: ./offline_assets)")

    parser_args = subparsers.add_parser("get-args", help="Just generate CMake flags (if already extracted)")
    parser_args.add_argument("assets_dir", help="Path to the previously extracted assets directory")

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(1)

    if len(sys.argv) == 2 and sys.argv[1].endswith('.zip'):
        apply_offline_assets(sys.argv[1], "./offline_assets")
        sys.exit(0)

    args = parser.parse_args()

    if args.command == "prepare":
        prepare_offline_assets(args.archive_name)
    elif args.command == "apply":
        apply_offline_assets(args.archive, args.out_dir)
    elif args.command == "get-args":
        generate_cmake_args(args.assets_dir, auto_applied=False)