#ifndef DALIMQTT_OTASERVICE_ICC
#define DALIMQTT_OTASERVICE_ICC

namespace daliMQTT {

inline bool OtaService::isUpdating() const noexcept {
    return m_isUpdating.load(std::memory_order_relaxed);
}

inline OtaStatus OtaService::getStatus() const noexcept {
    return m_status.load(std::memory_order_relaxed);
}

inline void OtaService::setProgressCallback(OtaProgressCallback cb, void* ctx) noexcept {
    m_progressCb = cb;
    m_progressCtx = ctx;
}

inline void OtaService::setVersionCallback(OtaVersionCallback cb, void* ctx) noexcept {
    m_versionCb = cb;
    m_versionCtx = ctx;
}

inline OtaVersionInfo OtaService::getVersionInfo() const noexcept {
    std::lock_guard<std::mutex> lock(m_infoMutex);
    return m_versionInfo;
}
} // namespace daliMQTT

#endif // DALIMQTT_OTASERVICE_ICC