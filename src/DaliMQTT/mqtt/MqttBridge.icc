#ifndef DALIMQTT_MQTTBRIDGE_ICC
#define DALIMQTT_MQTTBRIDGE_ICC

namespace daliMQTT {

inline bool MqttBridge::enqueueIncomingMessage(const char* topic, const int topicLen, const char* data,
                                               const int dataLen) const {
    if (!m_cmdQueue || topicLen <= 0 || topicLen >= 96 || dataLen >= 384    ) {
        return false;
    }

    MqttIncomingMessage msg{};
    msg.topic.assign(topic, topicLen);
    if (data && dataLen > 0) {
        msg.payload.assign(data, dataLen);
    }
    const BaseType_t res = xQueueSend(m_cmdQueue, &msg, pdMS_TO_TICKS(100));
    if (res != pdTRUE) {
        ESP_LOGE("MqttBridge", "CMD Queue overflow! Command dropped for topic: %.*s", topicLen, topic);
        return false;
    }
    return true;
}

} // namespace daliMQTT

#endif // DALIMQTT_MQTTBRIDGE_ICC