#ifndef DALIMQTT_DALIBUSENGINE_ICC
#define DALIMQTT_DALIBUSENGINE_ICC

namespace daliMQTT {

constexpr uint8_t DaliBusEngine::makeAddressByte(const DaliAddressType type, const uint8_t addr,
                                                 const bool isCommand) noexcept {
    uint8_t byte = 0;
    switch (type) {
    case DaliAddressType::Short:
        byte = static_cast<uint8_t>((addr & 0x3F) << 1);
        break;
    case DaliAddressType::Group:
        byte = static_cast<uint8_t>(0x80 | ((addr & 0x0F) << 1));
        break;
    case DaliAddressType::Broadcast:
        byte = 0xFE;
        break;
    case DaliAddressType::Special:
        byte = static_cast<uint8_t>(0xA0 | (addr & 0x1F));
        break;
    }
    if (isCommand)
        byte |= 0x01;
    return byte;
}

constexpr uint32_t DaliBusEngine::makeFrame16(const uint8_t addressByte, const uint8_t opcodeByte) noexcept {
    return static_cast<uint32_t>((static_cast<uint16_t>(addressByte) << 8) | opcodeByte);
}

constexpr uint32_t DaliBusEngine::makeFrame24(const uint8_t addrByte, const uint8_t instByte,
                                              const uint8_t opcodeByte) noexcept {
    return (static_cast<uint32_t>(addrByte) << 16) | (static_cast<uint32_t>(instByte) << 8) | opcodeByte;
}

inline esp_err_t DaliBusEngine::sendDACP(const DaliAddressType addrType, const uint8_t addr,
                                         const uint8_t level) const {
    const uint8_t addrByte = makeAddressByte(addrType, addr, false);
    TransactionRequest req{.data = makeFrame16(addrByte, level),
                           .bits = 16,
                           .isQuery = false,
                           .sendTwice = false,
                           .acceptAnyReplyAsYes = false};
    return executeTransaction(req, nullptr);
}

inline esp_err_t DaliBusEngine::sendCommand(const DaliAddressType addrType, const uint8_t addr, const OpCode opcode,
                                            const bool sendTwice) const {
    const uint8_t addrByte = makeAddressByte(addrType, addr, true);
    TransactionRequest req{.data = makeFrame16(addrByte, static_cast<uint8_t>(opcode)),
                           .bits = 16,
                           .isQuery = false,
                           .sendTwice = sendTwice,
                           .acceptAnyReplyAsYes = false};
    return executeTransaction(req, nullptr);
}

inline esp_err_t DaliBusEngine::sendSpecialCommand(const SpecialOpCode opcode, const uint8_t data,
                                                   const bool sendTwice) const {
    const TransactionRequest req{.data = makeFrame16(static_cast<uint8_t>(opcode), data),
                                 .bits = 16,
                                 .isQuery = false,
                                 .sendTwice = sendTwice,
                                 .acceptAnyReplyAsYes = false};
    return executeTransaction(req, nullptr);
}

inline esp_err_t DaliBusEngine::sendSpecial24BitCommand(const uint8_t inst, const uint8_t opcode,
                                                        const bool sendTwice) const {
    const TransactionRequest req{.data = makeFrame24(0xC1, inst, opcode),
                                 .bits = 24,
                                 .isQuery = false,
                                 .sendTwice = sendTwice,
                                 .acceptAnyReplyAsYes = false};
    return executeTransaction(req, nullptr);
}

inline esp_err_t DaliBusEngine::sendInputDeviceCommand(const uint8_t shortAddr, const uint8_t instance,
                                                       const uint8_t opcode) const {
    const uint8_t addrByte = static_cast<uint8_t>((shortAddr << 1) | 0x01);
    const TransactionRequest req{.data = makeFrame24(addrByte, instance, opcode),
                                 .bits = 24,
                                 .isQuery = false,
                                 .sendTwice = false,
                                 .acceptAnyReplyAsYes = false};
    return executeTransaction(req, nullptr);
}

inline esp_err_t DaliBusEngine::sendDevice24BitCommand(const uint8_t addrByte, const uint8_t opcode,
                                                       const bool sendTwice) const {
    const TransactionRequest req{.data = makeFrame24(addrByte, 0xFE, opcode),
                                 .bits = 24,
                                 .isQuery = false,
                                 .sendTwice = sendTwice,
                                 .acceptAnyReplyAsYes = false};
    return executeTransaction(req, nullptr);
}

inline std::optional<uint8_t> DaliBusEngine::query(const DaliAddressType addrType, const uint8_t addr,
                                                   const OpCode opcode) const {
    const uint8_t addrByte = makeAddressByte(addrType, addr, true);
    return queryRaw(makeFrame16(addrByte, static_cast<uint8_t>(opcode)), 16);
}

inline std::optional<uint8_t> DaliBusEngine::querySpecial(const SpecialOpCode opcode, const uint8_t data) const {
    return queryRaw(makeFrame16(static_cast<uint8_t>(opcode), data), 16);
}

inline esp_err_t DaliBusEngine::setDtr0(const uint8_t value) const {
    return sendSpecialCommand(SpecialOpCode::Dtr0, value, false);
}

inline esp_err_t DaliBusEngine::setDtr1(const uint8_t value) const {
    return sendSpecialCommand(SpecialOpCode::Dtr1, value, false);
}

inline esp_err_t DaliBusEngine::setDtr2(const uint8_t value) const {
    return sendSpecialCommand(SpecialOpCode::Dtr2, value, false);
}

inline std::optional<uint8_t> DaliBusEngine::readMemoryLocation(const uint8_t shortAddr, const uint8_t bank,
                                                                const uint8_t offset) const {
    DaliBusLock lock(*this);
    if (setDtr1(bank) != ESP_OK) return std::nullopt;
    if (setDtr0(offset) != ESP_OK) return std::nullopt;
    return query(DaliAddressType::Short, shortAddr, OpCode::ReadMemoryLocation);
}

inline bool DaliBusEngine::readMemoryBlock(const uint8_t shortAddr, const uint8_t bank,
                                           const uint8_t startOffset, uint8_t* outBuffer,
                                           const uint8_t length) const {
    if (!outBuffer || length == 0) return false;

    DaliBusLock lock(*this);

    if (setDtr1(bank) != ESP_OK || setDtr0(startOffset) != ESP_OK) {
        return false;
    }

    for (uint8_t i = 0; i < length; ++i) {
        auto valOpt = query(DaliAddressType::Short, shortAddr, OpCode::ReadMemoryLocation);
        if (!valOpt.has_value()) {
            return false;
        }
        outBuffer[i] = *valOpt;
        vTaskDelay(pdMS_TO_TICKS(10));
    }

    return true;
}

[[nodiscard]] inline BusHealth DaliBusEngine::checkHealth() const noexcept {
    if (m_transceiver.getPhysicalBusState() == DaliBusPhysicalState::StuckActive) {
        return BusHealth::ShortCircuit;
    }
    return BusHealth::Ok;
}

} // namespace daliMQTT

#endif // DALIMQTT_DALIBUSENGINE_ICC